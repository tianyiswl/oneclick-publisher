      "dot": "cyan",
      "title": "身份合同",
      "items": [
        "每个 Facebook Page 单独保存为 type=9 账号",
        "accountReference 保存稳定 Page ID，不能只靠名称猜测",
        "调用方只传 accountId，由身份服务解析并回读实际 Page"
      ]
    },
    {
      "dot": "amber",
      "title": "人工临界点",
      "items": [
        "默认只允许预检，预检不得点击最终发布",
        "正式发布必须使用短期一次性授权凭证",
        "平台要求扫码或验证码时暂停并等待用户处理"
      ]
    },
    {
      "dot": "rose",
      "title": "回读与去重",
      "items": [
        "授权消费、任务和 Page 级 Claim 必须在同一事务创建",
        "final_action_claimed 与实际点击分开记录",
        "成功必须回读同一 Page 新增且唯一的 Reel ID 或 URL",
        "结果不明时锁住自动重试，先做只读核对"
