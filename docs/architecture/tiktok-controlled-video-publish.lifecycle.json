{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "TikTok 受控发布生命周期",
    "output": "docs/architecture/tiktok-controlled-video-publish.lifecycle.html",
    "quality_profile": "showcase",
    "viewBox": [1380, 652],
    "views": [
      {
        "id": "formal-main-path",
        "label": "正式发布主链",
        "focus": ["local_preflight_passed", "platform_page_active", "platform_form_verified", "final_action_triggered", "platform_accepted", "published_readback_confirmed"],
        "note": "表单核对后恰好一次 Post；平台接受与作品回读是两层证据。"
      },
      {
        "id": "form-check-stop",
        "label": "平台表单检查",
        "focus": ["local_preflight_passed", "platform_page_active", "platform_form_verified", "failed_before_final_action"],
        "note": "platform_form_check 会发生上传写入；定时控件不可用或失败时在最终动作前终止。"
      },
      {
        "id": "failure-and-ambiguity",
        "label": "失败、结果不明与防重复",
        "focus": ["scheduled_accepted", "scheduled_readback_confirmed", "failed_before_final_action", "final_action_triggered", "ambiguous", "duplicate_blocked"],
        "note": "定时成功只证明排期存在且 publishedAt=null；定时失败不回退 Post，最终动作后也不自动重试。"
      }
    ]
  },
  "lanes": [
    {"id": "main", "label": "正式发布证据主链"},
    {"id": "pre_final", "label": "人工验证与立即发布回读"},
    {"id": "scheduled", "label": "平台原生定时证据"},
    {"id": "terminal", "label": "失败、结果不明与防重复终态"}
  ],
  "states": [
    {
      "id": "local_preflight_passed",
      "type": "start",
      "label": "本地预检通过",
      "sublabel": "零平台写入",
      "lane": "main",
      "col": 0,
      "width": 112,
      "step": "01",
      "tag": "preflight"
    },
    {
      "id": "final_action_triggered",
      "type": "active",
      "label": "最终动作已触发",
      "sublabel": "恰好一次 Post 或 Schedule",
      "lane": "main",
      "col": 3,
      "width": 120,
      "step": "04",
      "tag": "no auto retry"
    },
    {
      "id": "platform_accepted",
      "type": "success",
      "label": "平台已受理",
      "sublabel": "platform_accepted · 明确反馈",
      "lane": "main",
      "col": 4,
      "width": 110,
      "step": "05",
      "tag": "receipt"
    },
    {
      "id": "published_readback_confirmed",
      "type": "success",
      "label": "作品回读已确认",
      "sublabel": "published_readback_confirmed",
      "lane": "pre_final",
      "col": 2,
      "width": 120,
      "yOffset": -38,
      "step": "06",
      "tag": "confirmed"
    },
    {
      "id": "platform_page_active",
      "type": "active",
      "label": "平台页面执行中",
      "sublabel": "Same Playwright Page",
      "lane": "main",
      "col": 1,
      "width": 120,
      "step": "02",
      "tag": "form check / formal"
    },
    {
      "id": "platform_form_verified",
      "type": "success",
      "label": "平台表单已核对",
      "sublabel": "已上传；Post / Schedule 前",
      "lane": "main",
      "col": 2,
      "width": 120,
      "step": "03",
      "tag": "platform_form_check"
    },
    {
      "id": "scheduled_accepted",
      "type": "success",
      "label": "排期已受理",
      "sublabel": "scheduled_accepted",
      "lane": "scheduled",
      "col": 1,
      "width": 108,
      "yOffset": 42,
      "tag": "not published"
    },
    {
      "id": "scheduled_readback_confirmed",
      "type": "success",
      "label": "排期回读已确认",
      "sublabel": "scheduled_readback_confirmed",
      "lane": "scheduled",
      "col": 2,
      "width": 130,
      "yOffset": 42,
      "tag": "publishedAt=null"
    },
    {
      "id": "failed_before_final_action",
      "type": "failure",
      "label": "最终动作前失败",
      "sublabel": "tiktok_schedule_unavailable 等",
      "lane": "terminal",
      "col": 0,
      "width": 120,
      "tag": "retry after new preflight"
    },
    {
      "id": "ambiguous",
      "type": "failure",
      "label": "结果不明",
      "sublabel": "ambiguous · Post 后只读核对",
      "lane": "terminal",
      "col": 1,
      "width": 120,
      "tag": "read-only reconcile"
    },
    {
      "id": "duplicate_blocked",
      "type": "failure",
      "label": "重复提交已阻止",
      "sublabel": "duplicate_blocked · 同一指纹",
      "lane": "terminal",
      "col": 2,
      "width": 120,
      "tag": "terminal guard"
    }
  ],
  "transitions": [
    {
      "id": "preflight-to-platform-page",
      "from": "local_preflight_passed",
      "to": "platform_page_active",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "platform-page-to-form-check",
      "from": "platform_page_active",
      "to": "platform_form_verified",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "form-check-to-final-action",
      "from": "platform_form_verified",
      "to": "final_action_triggered",
      "variant": "security",
      "route": "straight"
    },
    {
      "id": "schedule-control-failed",
      "from": "platform_form_verified",
      "to": "failed_before_final_action",
      "note": "所有定时控制失败在最终动作前终止，不回退 Post",
      "variant": "security",
      "route": "straight"
    },
    {
      "id": "final-to-accepted",
      "from": "final_action_triggered",
      "to": "platform_accepted",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "final-to-scheduled-accepted",
      "from": "final_action_triggered",
      "to": "scheduled_accepted",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "scheduled-accepted-to-readback",
      "from": "scheduled_accepted",
      "to": "scheduled_readback_confirmed",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "accepted-to-readback",
      "from": "platform_accepted",
      "to": "published_readback_confirmed",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "final-to-ambiguous",
      "from": "final_action_triggered",
      "to": "ambiguous",
      "variant": "security",
      "route": "left-channel",
      "fromSide": "left",
      "toSide": "left",
      "channelX": 475
    },
    {
      "id": "ambiguous-duplicate-block",
      "from": "ambiguous",
      "to": "duplicate_blocked",
      "variant": "security",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "发布前证据顺序",
      "items": [
        "local_preflight_passed 只证明本地合同，platformWriteOccurred=false",
        "platform_page_active 之后必须先到 platform_form_verified",
        "platform_form_verified 之后才可恰好一次 Post 或 Schedule"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条成功证据",
      "items": [
        "立即分支：platform_accepted → published_readback_confirmed",
        "定时分支：scheduled_accepted → scheduled_readback_confirmed",
        "scheduled_readback_confirmed 必须保持 publishedAt=null，不等于已发布"
      ]
    },
    {
      "dot": "rose",
      "title": "租约与防重复",
      "items": [
        "tiktok_schedule_unavailable 与所有定时控制失败进入 failed_before_final_action",
        "最终动作后结果不明进入 ambiguous，只允许只读核对",
        "所有定时控制失败都在最终动作前终止",
        "failed_before_final_action 没有通往立即 Post 的迁移"
      ]
    }
  ]
}
