  "cards": [
    {
      "dot": "cyan",
      "title": "首轮范围",
      "items": [
        "单 TikTok 账号、单本地视频、立即公开",
        "默认 preflight 只读本地 manifest、账号记录和素材，不创建 Playwright",
        "内容项目与 Desktop UI 共用 Controlled CLI 和 Publish Service"
      ]
    },
    {
      "dot": "amber",
      "title": "平台写入与最终动作",
      "items": [
        "platform_form_check 会上传并填写，必须停在 Post 前",
        "formal 仅在消费一次性授权后允许一次 Post",
        "最终动作后结果不明只读核对，禁止自动重发"
      ]
    },
    {
      "dot": "rose",
      "title": "隐私与回执",
      "items": [
        "Cookie/session bytes 只留在 Isolated Session File",
        "request / receipt JSON 不携带 Cookie、验证码、二维码或会话内容",
        "任务库只保存白名单回执、阶段事件和 worker heartbeat"
      ]
    }
  ]
