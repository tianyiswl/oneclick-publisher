    {
      "dot": "cyan",
      "title": "首轮范围",
      "items": [
        "单 TikTok 账号、单本地视频、立即或平台原生定时公开",
        "controlled_publish 经 publish_service 进入唯一 TikTok 发布链",
        "TiktokVideo 复用同一 Playwright Page 填写表单与回读"
      ]
    },
    {
      "dot": "amber",
      "title": "平台写入与最终动作",
      "items": [
        "platform_form_check 会上传并填写，必须停在 Post / Schedule 前",
        "Schedule 前冻结稳定内容列表基线；点击后只接受唯一且不在基线中的精确新排期",
        "tiktok_schedule_unavailable 在最终动作前失败，禁止回退 Post"
      ]
    },
    {
      "dot": "rose",
      "title": "隐私与回执",
      "items": [
        "发布上下文创建前和运行后刷新都清除非 TikTok 域，并以 0600 原子替换会话文件",
        "CAPTCHA / 风控人工处理不是发布授权；request / receipt JSON 不携带会话内容",
        "任务库只保存白名单回执、阶段事件和 worker heartbeat；结果不明、受理与回读证据禁止释放 claim 或删除"
      ]
    }
  ]
