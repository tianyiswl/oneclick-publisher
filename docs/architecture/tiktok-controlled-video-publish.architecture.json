  "cards": [
    {
      "dot": "cyan",
      "title": "首轮范围",
      "items": [
        "单 TikTok 账号、单本地视频、立即或平台原生定时公开",
        "controlled_publish 经 publish_service 进入唯一 TikTok 发布链",
        "TiktokVideo 复用同一 Playwright Page 填写表单与回读"
      ]
    },
    {
      "dot": "amber",
      "title": "平台写入与最终动作",
      "items": [
        "platform_form_check 会上传并填写，必须停在 Post / Schedule 前",
        "formal 仅在消费一次性授权后允许一次 Post 或 Schedule",
        "tiktok_schedule_unavailable 在最终动作前失败，禁止回退 Post"
      ]
    },
    {
      "dot": "rose",
      "title": "隐私与回执",
      "items": [
        "Cookie/session bytes 只留在 Isolated Session File",
        "request / receipt JSON 不携带 Cookie、验证码、二维码或会话内容",
        "任务库只保存白名单回执、阶段事件和 worker heartbeat"
      ]
    }
  ]
